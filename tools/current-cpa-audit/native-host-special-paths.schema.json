    "critical_test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "name", "status"],
      "properties": {
        "category": {
          "enum": ["claude_replay", "multi_agent_v2", "no_copy", "ordered_tool", "originator", "response_failed"]
