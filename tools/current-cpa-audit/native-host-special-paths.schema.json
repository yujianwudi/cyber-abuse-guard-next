{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyber-abuse-guard.invalid/schemas/native-host-special-paths-v1.json",
  "title": "CAG native CPA Host special-path evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate",
    "claim_boundary",
    "cpa",
    "execution",
    "generated_at",
    "runtime",
    "schema",
    "status",
    "test_log",
    "test_source",
    "tool"
  ],
  "properties": {
    "candidate": {"$ref": "#/$defs/candidate"},
    "claim_boundary": {
      "const": "OWNER-RUN NATIVE HOST SPECIAL-PATH EVIDENCE; NOT INDEPENDENT PROOF"
    },
    "cpa": {"$ref": "#/$defs/cpa"},
    "execution": {"$ref": "#/$defs/execution"},
    "generated_at": {"$ref": "#/$defs/timestamp"},
    "runtime": {"$ref": "#/$defs/runtime"},
    "schema": {"const": "cyber-abuse-guard.native-host-special-paths.v1"},
    "status": {"const": "NATIVE_HOST_SPECIAL_PATHS_PASS"},
    "test_log": {"$ref": "#/$defs/test_log"},
    "test_source": {"$ref": "#/$defs/test_source"},
    "tool": {"$ref": "#/$defs/tool"}
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "minLength": 20,
      "maxLength": 20
    },
    "sha1": {
      "type": "string",
      "pattern": "^(?!0{40}$)[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "sha256_digest": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "id", "name", "run_attempt", "run_id", "size"],
      "properties": {
        "digest": {"$ref": "#/$defs/sha256_digest"},
        "id": {"type": "integer", "minimum": 1},
        "name": {"const": "cyber-abuse-guard-linux-amd64-audit-candidate"},
        "run_attempt": {"type": "integer", "minimum": 1},
        "run_id": {"type": "integer", "minimum": 1},
        "size": {"type": "integer", "minimum": 1, "maximum": 1073741824}
      }
    },
    "candidate_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "name", "sha256"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidate_files": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "prefixItems": [
        {
          "$ref": "#/$defs/candidate_file",
          "properties": {
            "bytes": {"maximum": 2097152},
            "name": {"const": "audit-candidate-manifest.json"}
          }
        },
        {
          "$ref": "#/$defs/candidate_file",
          "properties": {"name": {"const": "build-metadata.json"}}
        },
        {
          "$ref": "#/$defs/candidate_file",
          "properties": {"name": {"const": "checksums.txt"}}
        },
        {
          "$ref": "#/$defs/candidate_file",
          "properties": {"name": {"const": "cyber-abuse-guard-v1.0.0.so"}}
        },
        {
          "$ref": "#/$defs/candidate_file",
          "properties": {"name": {"const": "cyber-abuse-guard-v1.0.0.so.sha256"}}
        },
        {
          "$ref": "#/$defs/candidate_file",
          "properties": {"name": {"const": "cyber-abuse-guard_1.0.0_linux_amd64.zip"}}
        },
        {
          "$ref": "#/$defs/candidate_file",
          "properties": {"name": {"const": "ruleset-manifest.json"}}
        },
        {
          "$ref": "#/$defs/candidate_file",
          "properties": {"name": {"const": "ruleset.sha256"}}
        },
        {
          "$ref": "#/$defs/candidate_file",
          "properties": {"name": {"const": "sbom.cdx.json"}}
        }
      ],
      "items": false
    },
    "candidate_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty", "event", "head_branch", "head_sha", "tree", "version"],
      "properties": {
        "commit": {"$ref": "#/$defs/sha1"},
        "dirty": {"const": false},
        "event": {"enum": ["pull_request", "push"]},
        "head_branch": {
          "type": "string",
          "pattern": "^(?!.*//)(?!.*\\.\\.)(?!.*@\\{)[A-Za-z0-9](?:[A-Za-z0-9._/-]{0,253}[A-Za-z0-9_-])?$",
          "minLength": 1,
          "maxLength": 255
        },
        "head_sha": {"$ref": "#/$defs/sha1"},
        "tree": {"$ref": "#/$defs/sha1"},
        "version": {"const": "1.0.0"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "files", "manifest_sha256", "repository", "so", "source", "workflow"],
      "properties": {
        "artifact": {"$ref": "#/$defs/artifact"},
        "files": {"$ref": "#/$defs/candidate_files"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "repository": {"const": "yujianwudi/cyber-abuse-guard-next"},
        "so": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "sha256"],
          "properties": {
            "name": {"const": "cyber-abuse-guard-v1.0.0.so"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "source": {"$ref": "#/$defs/candidate_source"},
        "workflow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "path"],
          "properties": {
            "name": {"const": "CI"},
            "path": {"const": ".github/workflows/ci.yml"}
          }
        }
      }
    },
    "cpa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tag"],
      "properties": {
        "commit": {"const": "2e6b1d83f6c304a102aa33c1faf0a4f94d0d331e"},
        "tag": {"const": "v7.2.125"}
      }
    },
    "command": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        {"const": "go"},
        {"const": "test"},
        {"const": "-json"},
        {"const": "-count=1"},
        {"const": "-run=^TestCPAPluginHostBlocksBeforeUpstream$"},
        {"const": "-tags=integration,sqlite_omit_load_extension"},
        {"const": "./integration"}
      ],
      "items": false
