            {"$ref": "#/$defs/critical_test", "properties": {"category": {"const": "multi_agent_v2"}, "name": {"const": "TestCPAPluginHostBlocksBeforeUpstream/allow-codex-multi-agent-v2-inert-tool-description-http"}}},
