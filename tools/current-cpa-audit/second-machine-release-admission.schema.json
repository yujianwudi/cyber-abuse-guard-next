        "false_positives": { "const": 0 },
        "malicious_detected": { "const": 3 },
        "malicious_recall_denominator": { "const": 3 },
        "malicious_recall_percent": { "const": 100.0 },
        "mode": { "enum": ["audit", "balanced", "strict"] },
        "side_effect_violations": { "const": 0 },
        "supplemental_cases": { "const": 7 }
      },
      "required": ["all_supplemental_contracts_passed", "false_positive_denominator", "false_positives", "malicious_detected", "malicious_recall_denominator", "malicious_recall_percent", "mode", "side_effect_violations", "supplemental_cases"],
      "type": "object"
    },
    "timestamp": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
      "type": "string"
    },
    "tool_bundles": {
      "additionalProperties": false,
      "properties": {
        "admission": {
          "additionalProperties": false,
          "properties": {
            "schema_sha256": { "$ref": "#/$defs/sha256" },
            "source_sha256": { "$ref": "#/$defs/sha256" }
          },
          "required": ["schema_sha256", "source_sha256"],
          "type": "object"
        },
        "host_performance": { "$ref": "#/$defs/host_tool_hashes" },
        "machine": { "$ref": "#/$defs/machine_tool_hashes" },
        "native_host_special_paths": {
          "additionalProperties": false,
          "properties": {
            "schema_sha256": { "$ref": "#/$defs/sha256" },
            "source_sha256": { "$ref": "#/$defs/sha256" },
            "test_source_sha256": { "$ref": "#/$defs/sha256" }
          },
          "required": ["schema_sha256", "source_sha256", "test_source_sha256"],
          "type": "object"
        }
      },
      "required": ["admission", "host_performance", "machine", "native_host_special_paths"],
      "type": "object"
    },
    "machine_tool_hashes": {
      "additionalProperties": false,
      "properties": {
        "audit_contract_sha256": { "$ref": "#/$defs/sha256" },
        "bundle_sha256": { "$ref": "#/$defs/sha256" },
        "machine_schema_sha256": { "$ref": "#/$defs/sha256" },
        "mock_source_sha256": { "$ref": "#/$defs/sha256" },
        "policy_sha256": { "$ref": "#/$defs/sha256" },
        "run_source_sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["audit_contract_sha256", "bundle_sha256", "machine_schema_sha256", "mock_source_sha256", "policy_sha256", "run_source_sha256"],
      "type": "object"
    },
    "zip_source": {
      "additionalProperties": false,
      "properties": {
        "archive_member": { "minLength": 1, "type": "string" },
        "path": { "minLength": 1, "type": "string" },
        "repository": { "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "type": "string" },
        "repository_key": { "minLength": 1, "type": "string" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "text_sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["archive_member", "path", "repository", "repository_key", "source_sha256", "text_sha256"],
      "type": "object"
    }
  }
}
