{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyber-abuse-guard.invalid/schemas/current-cpa-host-admission-evidence-manifest-v1.json",
  "title": "CAG current CPA tracked Host admission raw evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate",
    "approved_runtime_identities_sha256",
    "cleanup",
    "collector_tool_identities",
    "config_sha256",
    "inputs",
    "observation_sources",
    "outputs",
    "producer",
    "run_id",
    "schema",
    "sqlite"
  ],
  "properties": {
    "schema": {"const": "cag-current-cpa-host-admission-evidence-manifest/v1"},
    "producer": {"const": "tracked_integrated_host_admission_collector"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{2,62}$"},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "collector_tool_identities": {"$ref": "#/$defs/tool_identities"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_artifact_digest",
        "candidate_manifest_sha256",
        "cag_commit",
        "cag_so_sha256",
        "cag_store_zip_sha256",
        "cag_tree",
        "cpa_commit",
        "cpa_tag"
      ],
      "properties": {
        "candidate_artifact_digest": {"$ref": "#/$defs/sha256_digest"},
        "candidate_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "cag_commit": {"$ref": "#/$defs/sha1"},
        "cag_so_sha256": {"$ref": "#/$defs/sha256"},
        "cag_store_zip_sha256": {"$ref": "#/$defs/sha256"},
        "cag_tree": {"$ref": "#/$defs/sha1"},
        "cpa_commit": {"const": "d9cea8904b14fbbebb77ef26e98ef08f6b48a724"},
        "cpa_tag": {"const": "v7.2.145"}
      }
    },
    "approved_runtime_identities_sha256": {"$ref": "#/$defs/sha256"},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpus_manifest",
        "approved_runtime_identities",
        "approved_tool_identities",
        "machine_evidence",
        "supplemental_manifest",
        "supplemental_policy",
        "supplemental_results",
        "transport_results"
      ],
      "properties": {
        "corpus_manifest": {"$ref": "#/$defs/sha256"},
        "approved_runtime_identities": {"$ref": "#/$defs/sha256"},
        "approved_tool_identities": {"$ref": "#/$defs/sha256"},
        "machine_evidence": {"$ref": "#/$defs/sha256"},
        "supplemental_manifest": {"$ref": "#/$defs/sha256"},
        "supplemental_policy": {"$ref": "#/$defs/sha256"},
        "supplemental_results": {"$ref": "#/$defs/sha256"},
        "transport_results": {"$ref": "#/$defs/sha256"}
      }
    },
    "observation_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cleanup", "endpoints", "failures", "mock_counters", "rpc_counters", "rss_bytes", "usage_records"],
      "properties": {
        "cleanup": {"const": "EXACT_LABEL_NAME_AND_DOCKER_INSPECT"},
        "endpoints": {"const": "REAL_HTTP_PRIVATE_BRIDGE"},
        "failures": {"const": "DOCKER_INSPECT_CAG_STATUS_AND_CPA_LOGS"},
        "mock_counters": {"const": "COUNTED_MOCK_CONTROL_STATS"},
        "rpc_counters": {"const": "CAG_MANAGEMENT_STATUS"},
        "rss_bytes": {"const": "PROC_CONTAINER_INIT_VMRSS"},
        "usage_records": {"const": "KEEPER_SQLITE_PERSISTED_CPA_POP_OLDEST"}
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audit_sqlite", "host_300s", "host_3600s", "realtime_routes"],
      "properties": {
        "audit_sqlite": {"$ref": "#/$defs/output_sqlite"},
        "host_300s": {"$ref": "#/$defs/output_300"},
        "host_3600s": {"$ref": "#/$defs/output_3600"},
        "realtime_routes": {"$ref": "#/$defs/output_realtime"}
      }
    },
    "sqlite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocked_credential_theft_events", "database_sha256", "event_rows", "evidence_bytes", "evidence_path", "quick_check", "raw_capture_rows", "schema_version", "wal_checkpoint"],
      "properties": {
        "blocked_credential_theft_events": {"type": "integer", "minimum": 2},
        "database_sha256": {"$ref": "#/$defs/sha256"},
        "event_rows": {"const": 2},
        "evidence_bytes": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "evidence_path": {"const": "host-admission/audit-events.sqlite3"},
        "quick_check": {"const": "ok"},
        "raw_capture_rows": {"const": 0},
        "schema_version": {"const": 7},
        "wal_checkpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["busy", "checkpointed_frames", "log_frames"],
          "properties": {
            "busy": {"const": 0},
            "checkpointed_frames": {"type": "integer", "minimum": 0},
            "log_frames": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_owned_resources_absent",
        "evidence_preserved",
        "global_prune_used",
        "resources",
        "runtime_root_absent",
        "secret_files_absent",
        "status",
        "unrelated_resources_touched"
      ],
      "properties": {
        "all_owned_resources_absent": {"const": true},
        "evidence_preserved": {"const": true},
        "global_prune_used": {"const": false},
        "resources": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "id", "kind", "name", "run_label"],
            "properties": {
              "action": {"const": "removed"},
              "id": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
              "kind": {"enum": ["container", "network"]},
              "name": {"type": "string", "minLength": 1, "maxLength": 128},
              "run_label": {"type": "string", "minLength": 3, "maxLength": 63}
            }
          }
        },
        "runtime_root_absent": {"const": true},
        "secret_files_absent": {"const": true},
        "status": {"const": "PASS"},
        "unrelated_resources_touched": {"const": false}
      }
    }
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^(?!0{40}$)[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "sha256_digest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"},
    "tool_identities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_runtime_identities_sha256",
        "audit_contract_sha256",
        "bundle_sha256",
        "collector_source_sha256",
        "config_schema_sha256",
        "evidence_manifest_schema_sha256",
        "host_admission_schema_sha256",
        "host_admission_source_sha256",
        "keeper_source_sha256",
        "release_admission_source_sha256",
        "run_source_sha256",
        "validator_sha256"
      ],
      "properties": {
        "approved_runtime_identities_sha256": {"$ref": "#/$defs/sha256"},
        "audit_contract_sha256": {"$ref": "#/$defs/sha256"},
        "bundle_sha256": {"$ref": "#/$defs/sha256"},
        "collector_source_sha256": {"$ref": "#/$defs/sha256"},
        "config_schema_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_manifest_schema_sha256": {"$ref": "#/$defs/sha256"},
        "host_admission_schema_sha256": {"$ref": "#/$defs/sha256"},
        "host_admission_source_sha256": {"$ref": "#/$defs/sha256"},
        "keeper_source_sha256": {"$ref": "#/$defs/sha256"},
        "release_admission_source_sha256": {"$ref": "#/$defs/sha256"},
        "run_source_sha256": {"$ref": "#/$defs/sha256"},
        "validator_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "output_base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "path", "row_count", "sha256"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 1},
        "path": {"type": "string"},
        "row_count": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "output_300": {
      "allOf": [
        {"$ref": "#/$defs/output_base"},
        {"properties": {"path": {"const": "host-admission/host-300s-samples.jsonl"}, "row_count": {"const": 301}}}
      ]
    },
    "output_sqlite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "path", "sha256"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 1},
        "path": {"const": "host-admission/audit-events.sqlite3"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "output_3600": {
      "allOf": [
        {"$ref": "#/$defs/output_base"},
        {"properties": {"path": {"const": "host-admission/host-3600s-samples.jsonl"}, "row_count": {"const": 3601}}}
      ]
    },
    "output_realtime": {
      "allOf": [
        {"$ref": "#/$defs/output_base"},
        {"properties": {"path": {"const": "host-admission/realtime-auth-boundary-routes.jsonl"}, "row_count": {"const": 14}}}
      ]
    }
  }
}
